<?xml version="1.0" encoding="utf-8"?>
<!--
  Fichiers partagés avec d'autres applications, le temps d'une opération :
  - updates/ : APK téléchargé, ouvert par l'installateur Android ;
  - photos/ : photo écrite par l'appareil photo, effacée dès sa lecture.
-->
<paths>
    <cache-path name="updates" path="updates/" />
    <cache-path name="photos" path="photos/" />
</paths>
